rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Fën · Ventas (caja) + Sistema Fën — Reglas de Firestore v1.5.0 (2026-10-21)
//  v1.5.0: (caja v2.3.0 y Sistema Fën v0.75.0, Etapa 2b) el catálogo se administra solo en Sistema Fën:
//          productos los crea, cambia y archiva SOLO la administración (la cajera solo marca tuvoVentas al vender);
//          areas, solo la administración (la caja ya no las crea). solicitudes_producto: la cajera crea un pedido
//          suyo, pendiente, con los campos de siempre (tipo 'producto', nombre, sucursal, por, en; precio y nota
//          opcionales) y lee los suyos; la administración los lee y los resuelve. Todo lo demás queda igual.
//  v1.4.0: (Sistema Fën v0.74.0, para la caja de la entrega 2b) pedidos de productos de la caja:
//          solicitudes_producto. La cajera crea un pedido suyo (pendiente) y lo lee; la administración
//          los lee y los resuelve (aprobada o rechazada). Nada se borra. Todo lo demás queda igual.
//  v1.3.0: agenda de Sistema Fën: agenda (lo de Fën, administración) y
//          agenda_personal (lo personal: solo lo ve y cambia quien lo creó).
//          Nada se borra: se marca "quitado". Todo lo demás queda igual.
//  v1.2.0: colecciones de Sistema Fën: equipos e historial (solo administración).
//          Todo lo de la caja queda exactamente igual.
//  v1.1.0: nueva colección resumenes_caja (resumen de cada cierre, caja v2.1).
//
//  Reemplazan a la regla anterior, que dejaba leer y escribir TODO a
//  cualquier usuario con sesión. Están escritas para que la caja siga
//  funcionando exactamente igual que hoy; solo bloquean lo que una
//  cajera no debería poder hacer:
//    · darse permisos de admin (o de visor de stock)
//    · borrar cualquier cosa (ventas, cajas, productos, stock...)
//    · cambiar precios o datos de productos existentes
//    · modificar ventas ajenas más allá de pedir anulación o
//      corregir el medio de pago (que queda firmado con su correo)
//    · aprobar anulaciones, corregir arqueos o registrar merma
//    · registrar ventas o cajas a nombre de otra persona
//  El visor de stock queda solo de lectura.
//
//  Roles (se administran SOLO desde la consola de Firebase):
//    admins/{uid}         → administrador
//    stock_viewers/{uid}  → visor de stock (solo lectura)
//    cualquier otro usuario con sesión → cajera / operación
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ayudas ────────────────────────────────────────────────
    function conSesion() {
      return request.auth != null;
    }
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function esVisor() {
      return conSesion() && exists(/databases/$(database)/documents/stock_viewers/$(request.auth.uid));
    }
    // Puede operar la caja: tiene sesión y no es solo visor (el admin también opera).
    function opera() {
      return conSesion() && (esAdmin() || !esVisor());
    }
    function miCorreo() {
      return request.auth.token.email;
    }
    // El cambio solo toca estos campos del documento.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // v1.5.0: los productos y las áreas ya NO los gestiona la caja (solo Sistema Fën, administración).
    // Esto queda solo para las listas de config que la caja todavía cambia (tipos de leche y motivos
    // de merma; subcategorías y recetas ocultas como antes). Para que lo haga solo el admin, cambia `true` por `false`.
    function cajeraGestionaCatalogo() {
      return true;
    }
    function gestionaCatalogo() {
      return esAdmin() || (opera() && cajeraGestionaCatalogo());
    }

    // ── Roles: cada uno lee solo su propio documento; nadie los escribe desde la app ──
    match /admins/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }
    match /stock_viewers/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    // ── Catálogo ───────────────────────────────────────────────
    // v1.5.0: los productos se crean, cambian y archivan solo en Sistema Fën (administración).
    // La caja solo marca tuvoVentas (true) al vender. Nada se borra: se archiva (activo false).
    match /productos/{id} {
      allow read: if conSesion();
      allow create: if esAdmin();
      allow update: if esAdmin()
                    || (opera() && soloCambia(['tuvoVentas']) && request.resource.data.tuvoVentas == true);
      allow delete: if esAdmin();
    }

    // v1.5.0: una sola lista de áreas (la de Sistema Fën). La caja ya no las crea.
    match /areas/{id} {
      allow read: if conSesion();
      allow create, update, delete: if esAdmin();
    }

    match /config/{id} {
      allow read: if conSesion();
      // tiposLeche y motivosMerma: la app los crea con valores base si no existen.
      allow create: if esAdmin() || (opera() && id in ['tiposLeche', 'motivosMerma'])
                    || (gestionaCatalogo() && id in ['subcategorias', 'recetasOcultas']);
      allow update: if esAdmin()
                    || (gestionaCatalogo() && id in ['tiposLeche', 'motivosMerma', 'subcategorias', 'recetasOcultas']);
      // tiemposPago y reconciliacionPeriodos: solo admin.
      allow delete: if false;
    }

    match /equivalenciasNombres/{id} {
      allow read: if conSesion();
      allow write: if esAdmin();
    }

    // ── Venta ─────────────────────────────────────────────────
    match /ventas/{id} {
      allow read: if conSesion();
      allow create: if opera() && request.resource.data.usuario == miCorreo();
      allow update: if esAdmin()
                    // pedir anulación (la aprueba el admin)
                    || (opera() && soloCambia(['solicitudAnulacionPendiente'])
                        && request.resource.data.solicitudAnulacionPendiente == true)
                    // corregir medio de pago: queda firmado con el correo de quien lo cambió
                    || (opera() && soloCambia(['medioPago', 'medioPagoOriginal', 'medioPagoEditadoPor', 'medioPagoEditadoFecha'])
                        && request.resource.data.medioPagoEditadoPor == miCorreo());
      allow delete: if false; // las ventas nunca se borran: se anulan
    }

    match /mesas/{id} {
      allow read: if conSesion();
      allow create, update: if opera();
      allow delete: if false;
    }

    match /solicitudes_anulacion/{id} {
      allow read: if conSesion();
      allow create: if opera()
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.solicitadoPor == miCorreo();
      allow update: if esAdmin(); // aprobar o rechazar
      allow delete: if false;
    }

    // ── Caja ──────────────────────────────────────────────────
    match /cajas/{id} {
      allow read: if conSesion();
      allow create: if opera()
                    && request.resource.data.usuario == miCorreo()
                    && request.resource.data.estado == 'abierta';
      // Totales, cierre y exportación se actualizan durante el turno.
      allow update: if opera();
      allow delete: if false;
    }

    // v1.1.0: resumen de cada caja cerrada (por producto, área y medio de pago).
    // Lo escribe la caja al cerrar o reenviar; lo leen los informes y Sistema Fën.
    match /resumenes_caja/{id} {
      allow read: if conSesion();
      allow create, update: if opera();
      allow delete: if false;
    }

    match /evaluacion_caja/{id} {
      allow read: if conSesion();
      allow create: if opera();
      allow update: if esAdmin(); // correcciones de arqueo
      allow delete: if false;
    }

    // ── Stock y merma ─────────────────────────────────────────
    match /stock/{id} {
      allow read: if conSesion();
      allow create, update: if opera(); // ingreso, ajustes y descuento al vender
      allow delete: if false;
    }

    match /stockMovimientos/{id} {
      allow read: if conSesion();
      allow create: if opera();
      allow update, delete: if false;
    }

    match /merma/{id} {
      allow read: if conSesion();
      allow create, update: if esAdmin(); // en la app, registrar merma es solo admin
      allow delete: if false;
    }

    match /meta_rotacion/{id} {
      allow read: if conSesion();
      allow write: if esAdmin(); // "Forzar rotación" es solo admin
    }

    // ── Sistema Fën (v1.2.0) ──────────────────────────────────
    // Equipos autorizados para entrar a Sistema Fën: solo administración.
    // Un equipo se crea a nombre de quien entra y nace vigente; revocar es
    // un cambio de estado (nunca se borra, queda la historia).
    match /equipos/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.estado == 'vigente';
      // No se cambia de dueño, y un equipo revocado no vuelve a quedar vigente
      // (para volver a usarlo se autoriza de nuevo, con la contraseña).
      allow update: if esAdmin()
                    && request.resource.data.uid == resource.data.uid
                    && !(resource.data.estado == 'revocado' && request.resource.data.estado != 'revocado');
      allow delete: if false;
    }
    // Historial de Sistema Fën: se agrega, nunca se cambia ni se borra.
    match /historial/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && request.resource.data.por == miCorreo();
      allow update, delete: if false;
    }

    // Agenda de Fën (Sistema Fën): solo administración. No se borra: se marca quitado.
    match /agenda/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && request.resource.data.creadoPor == miCorreo();
      allow update: if esAdmin() && request.resource.data.creadoPor == resource.data.creadoPor;
      allow delete: if false;
    }
    // Agenda personal: solo la ve y la cambia quien la creó (ni otras cuentas de administración).
    match /agenda_personal/{id} {
      allow read: if conSesion() && resource.data.uid == request.auth.uid;
      allow create: if esAdmin() && request.resource.data.uid == request.auth.uid;
      allow update: if conSesion() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── v1.4.0 · v1.5.0 · Pedidos de productos de la caja (los resuelve Sistema Fën → Catálogo → Productos) ──
    // La caja v2.3.0 escribe { tipo 'producto', nombre, sucursal, precioSugerido | null, nota, estado 'pendiente', por, en }.
    function pedidoValido(d) {
      return d.keys().hasOnly(['tipo', 'nombre', 'sucursal', 'precioSugerido', 'nota', 'estado', 'por', 'en', 'catalogoId', 'recetaId', 'reventaId'])
          && d.keys().hasAll(['tipo', 'nombre', 'sucursal', 'estado', 'por', 'en'])
          && d.tipo == 'producto'
          && d.estado == 'pendiente'
          && d.por == miCorreo()
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
          && d.sucursal in ['ainavillo', 'barros_arana']
          && d.en is timestamp
          && (!('precioSugerido' in d) || d.precioSugerido == null || (d.precioSugerido is number && d.precioSugerido > 0))
          && (!('nota' in d) || (d.nota is string && d.nota.size() <= 300));
    }
    match /solicitudes_producto/{id} {
      allow read: if esAdmin() || (opera() && resource.data.por == miCorreo());
      allow create: if opera() && pedidoValido(request.resource.data);
      allow update: if esAdmin() && request.resource.data.estado in ['aprobada', 'rechazada'];
      allow delete: if false;
    }

    // ── Cualquier otra colección: cerrada ─────────────────────
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
