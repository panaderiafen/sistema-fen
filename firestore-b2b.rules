rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Fën · B2B (proyecto Firebase fen-b2b) — Reglas de Firestore v1.11.0 (2026-11-27)
//
//  v1.11.0: (logística v1.5.5 · Sistema Fën v0.139.1) logística también marca pagada (y deshace) una orden que ya tiene folio:
//          a veces se factura antes de que logística cobre. Al recibirlo, Sistema Fën lo deja como abono del folio. Todo lo demás igual.
//  v1.10.0: (Sistema Fën v0.139.0 · logística v1.5.0) gastos_logistica/{id}: los gastos que logística paga con la
//          plata de los cobros (estacionamiento, compras chicas). Logística crea los suyos (a su nombre, monto
//          entre 1 y 200.000, pendientes de recibir) y los quita mientras administración no los recibe; los ve
//          solo ella y administración. Administración los marca recibidos. Nada se borra. Todo lo demás igual.
//  v1.9.0: (Sistema Fën v0.131.0 · logística v1.4.0) Cobros en efectivo: logística marca pagada en efectivo una
//          orden sin folio y pendiente (solo los campos del pago, por el total de la orden, a su nombre y
//          "pendiente de recibir"), y lo deshace mientras administración no lo recibe. Todo lo demás igual.
//  v1.8.0: (Sistema Fën v0.80.0) listas_precios/{id}: las listas de precios de Ventas B2B → Listas de
//          precios. Solo administración las lee, crea y cambia; nada se borra. Logística no las ve.
//          (La portada y las condiciones van en config/listasPrecios, que ya era solo de administración.)
//          Todo lo demás queda igual a la v1.7.0.
//  v1.7.0: (Sistema Fën v0.74.0 · logística v1.3.0) logística lee config/catalogoDisponible (la lista
//          de productos del Catálogo que todavía no están en B2B, la escribe Sistema Fën) y
//          crea órdenes sin marcarlas para la planilla (planillaPendiente false: la copia está apagada).
//          Todo lo demás queda igual.
//  v1.6.0: cobranza/{clienteId}: compromisos de pago, "dice que ya pagó" y gestiones de cobranza;
//          solo administración; las gestiones solo se agregan (nunca se quitan).
//  v1.5.0: conciliación: deshacer (un abono resuelto vuelve a "pendiente" solo sumando 1 a
//          "deshechos") y saldo a favor (favorDisponible entre 0 y el monto del abono).
//  v1.4.0: conciliación bancaria (movimientos de la cartola), solo administración.
//  v1.3.0: catálogo editable en Sistema Fën; quien pasa a la planilla (también
//          logística) puede marcar como pasados clientes y productos.
//  v1.2.0: logística también puede solicitar la anulación de una orden (la anula administración)
//          y marca "Entendido" en la respuesta a sus solicitudes.
//  v1.1.0: la app de logística (fen-logistica) crea y edita órdenes y manda
//          solicitudes; el N° de orden sale de un contador que solo sube de a 1.
//  v1.0.0: base nueva; solo administración escribe.
//
//  Roles (se administran SOLO desde la consola de Firebase):
//    admins/{uid}      → administración (Sistema Fën): lee y escribe todo
//    logistica/{uid}   → la persona que registra las órdenes:
//                        · lee clientes, productos y órdenes
//                        · crea órdenes (con el N° que sigue) y edita las que no
//                          tienen folio ni pago y no están anuladas ni archivadas
//                        · deja el registro de cada edición y manda solicitudes
//    cualquier otra cuenta → nada
//
//  Nada se borra: ninguna regla permite delete. Una orden se anula (estado
//  "anulada"); lo que sale de la planilla queda marcado (quitadoEnPlanilla).
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function esLogistica() {
      return conSesion() && exists(/databases/$(database)/documents/logistica/$(request.auth.uid));
    }
    function miCorreo() {
      return request.auth.token.email;
    }
    function nuevo() {
      return request.resource.data;
    }
    function antes() {
      return resource.data;
    }
    function cambian() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Una orden bien formada (la escriba quien la escriba)
    function ordenValida(n) {
      return nuevo().n is int && string(nuevo().n) == n
          && nuevo().total is number && nuevo().neto is number && nuevo().iva is number
          && nuevo().lineas is list && nuevo().cliente is string;
    }
    // Lo que logística puede dejar en una orden: sin folio, sin pago, activa
    function ordenDeLogistica(n) {
      return ordenValida(n)
          && nuevo().lineas.size() > 0 && nuevo().lineas.size() <= 80
          && nuevo().cliente.size() > 0
          && nuevo().folio == null && nuevo().sinFolio == true
          && nuevo().estadoPago == 'PENDIENTE' && nuevo().fechaPago == null
          && nuevo().estado == 'activa' && nuevo().archivada == false
          && nuevo().quitadoEnPlanilla == false
          // v1.7.0: true (logística hasta la v1.2.1) o false (v1.3.0: copia a la planilla apagada)
          && nuevo().planillaPendiente is bool;
    }
    // El contador sube exactamente 1 en la misma escritura, y n es el valor que tenía
    function tomaElNumero(n) {
      return get(/databases/$(database)/documents/contadores/ordenes).data.siguiente == int(n)
          && getAfter(/databases/$(database)/documents/contadores/ordenes).data.siguiente == int(n) + 1;
    }

    // ── Roles: cada cuenta ve solo el suyo; se crean en la consola ──
    match /admins/{uid} {
      allow read: if conSesion() && request.auth.uid == uid;
      allow write: if false;
    }
    match /logistica/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    // ── Catálogo: logística lee, administración escribe ──
    match /clientes/{id} {
      allow read: if esAdmin() || esLogistica();
      allow create, update: if esAdmin() && nuevo().nombre is string && nuevo().nombre.size() > 0;
      allow update: if esLogistica() && cambian().hasOnly(['planillaPendiente', 'planillaEn']) && nuevo().planillaPendiente == false;
      allow delete: if false;
    }
    match /productos/{id} {
      allow read: if esAdmin() || esLogistica();
      allow create, update: if esAdmin() && nuevo().nombre is string && nuevo().nombre.size() > 0;
      allow update: if esLogistica() && cambian().hasOnly(['planillaPendiente', 'planillaEn']) && nuevo().planillaPendiente == false;
      allow delete: if false;
    }

    // ── Órdenes ──
    match /ordenes/{n} {
      allow read: if esAdmin() || esLogistica();
      allow create: if (esAdmin() && ordenValida(n))
                    || (esLogistica() && ordenDeLogistica(n) && tomaElNumero(n)
                        && nuevo().creada.por == miCorreo());
      allow update: if (esAdmin() && ordenValida(n))
                    // logística edita solo lo que todavía no tiene folio ni pago
                    || (esLogistica() && antes().folio == null && antes().estadoPago == 'PENDIENTE'
                        && antes().estado == 'activa' && antes().archivada == false
                        && ordenDeLogistica(n) && nuevo().n == antes().n
                        && nuevo().get('creada', null) == antes().get('creada', null))
                    // v1.9.0: logística marca pagada en efectivo (Cobros) una orden pendiente (v1.11.0: también con folio)
                    || (esLogistica() && antes().get('estadoPago', 'PENDIENTE') == 'PENDIENTE'
                        && antes().estado == 'activa' && antes().archivada == false
                        && cambian().hasOnly(['estadoPago', 'fechaPago', 'medioPago', 'pagoOrden'])
                        && nuevo().estadoPago == 'PAGADO' && nuevo().fechaPago is string
                        && nuevo().pagoOrden.logistica == true && nuevo().pagoOrden.pendienteAdmin == true
                        && nuevo().pagoOrden.medio == 'efectivo' && nuevo().pagoOrden.por == miCorreo()
                        && nuevo().pagoOrden.monto == antes().total)
                    // v1.9.0: y lo deshace mientras administración no lo recibe (v1.11.0: también con folio)
                    || (esLogistica() && antes().get('estadoPago', '') == 'PAGADO'
                        && antes().get('pagoOrden', null) != null
                        && antes().pagoOrden.get('logistica', false) == true && antes().pagoOrden.get('pendienteAdmin', false) == true
                        && cambian().hasOnly(['estadoPago', 'fechaPago', 'medioPago', 'pagoOrden'])
                        && nuevo().estadoPago == 'PENDIENTE' && nuevo().fechaPago == null && nuevo().pagoOrden == null)
                    // cualquiera de los dos marca que ya pasó a la planilla (lo hace el script con su sesión)
                    || ((esAdmin() || esLogistica()) && cambian().hasOnly(['planillaPendiente', 'planillaEn'])
                        && nuevo().planillaPendiente == false);
      allow delete: if false;
    }
    // El N° que sigue: logística lo sube de a 1 (junto con crear la orden)
    match /contadores/{id} {
      allow read: if esAdmin() || (esLogistica() && id == 'ordenes');
      allow create: if esAdmin();
      allow update: if esAdmin()
                    || (esLogistica() && id == 'ordenes' && nuevo().siguiente == antes().siguiente + 1
                        && cambian().hasOnly(['siguiente', 'en', 'desde'])
                        // solo junto con crear esa orden (no se pueden saltar números)
                        && existsAfter(/databases/$(database)/documents/ordenes/$(string(antes().siguiente))));
      allow delete: if false;
    }
    // Registro de cada edición de una orden
    match /ediciones/{id} {
      allow read: if esAdmin() || esLogistica();
      allow create: if esAdmin() || (esLogistica() && nuevo().por == miCorreo() && nuevo().n is int
                                     && nuevo().motivo is string && nuevo().motivo.size() > 2);
      allow update: if esAdmin()
                    || ((esLogistica()) && cambian().hasOnly(['planillaPendiente', 'planillaEn']) && nuevo().planillaPendiente == false);
      allow delete: if false;
    }
    // Solicitudes de logística (precio especial o producto nuevo): ella ve las suyas
    match /solicitudes/{id} {
      allow read: if esAdmin() || (esLogistica() && resource.data.por == miCorreo());
      allow create: if esAdmin() || (esLogistica() && nuevo().por == miCorreo() && nuevo().estado == 'pendiente'
                                     && (nuevo().tipo in ['precio', 'producto']
                                         || (nuevo().tipo == 'anulacion' && nuevo().n is int)));
      // logística solo marca "Entendido" en la respuesta a una solicitud suya
      allow update: if esAdmin()
                    || (esLogistica() && antes().por == miCorreo() && cambian().hasOnly(['vista', 'vistaEn']) && nuevo().vista == true);
      allow delete: if false;
    }

    // v1.10.0 · Gastos de logística con la plata de los cobros
    match /gastos_logistica/{id} {
      allow read: if esAdmin() || (esLogistica() && resource.data.por == miCorreo());
      allow create: if esLogistica() && nuevo().por == miCorreo()
                    && nuevo().keys().hasOnly(['monto', 'que', 'detalle', 'boleta', 'fecha', 'por', 'en', 'pendienteAdmin', 'creado'])
                    && nuevo().monto is int && nuevo().monto > 0 && nuevo().monto <= 200000
                    && nuevo().que in ['estacionamiento', 'compra', 'bencina', 'otro']
                    && nuevo().detalle is string && nuevo().detalle.size() <= 120
                    && nuevo().boleta is bool && nuevo().fecha is string && nuevo().fecha.size() == 10
                    && nuevo().pendienteAdmin == true;
      // logística solo lo quita (anulado) mientras sigue pendiente; administración lo marca recibido
      allow update: if esAdmin()
                    || (esLogistica() && antes().por == miCorreo() && antes().pendienteAdmin == true
                        && cambian().hasOnly(['anulado', 'pendienteAdmin', 'anuladoEn'])
                        && nuevo().anulado == true && nuevo().pendienteAdmin == false);
      allow delete: if false;
    }

    // ── Solo administración ──
    match /abonos/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && nuevo().monto is number;
      allow delete: if false;
    }
    // Abonos de la cartola del banco (conciliación): se marcan, nunca se borran
    match /movimientos/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && nuevo().monto is number && nuevo().huella is string;
      // nunca cambian su huella ni su monto, y uno ya resuelto no vuelve a "pendiente" (así no se aplica dos veces)
      // v1.5.0: deshacer → vuelve a "pendiente" solo si "deshechos" sube exactamente en 1 (queda registro)
      allow update: if esAdmin() && nuevo().huella == antes().huella && nuevo().monto == antes().monto
                    && (antes().estado == 'pendiente' || nuevo().estado == antes().estado
                        || (nuevo().estado == 'pendiente' && nuevo().deshechos == antes().get('deshechos', 0) + 1))
                    && (!('favorDisponible' in nuevo()) || (nuevo().favorDisponible is number && nuevo().favorDisponible >= 0 && nuevo().favorDisponible <= nuevo().monto));
      allow delete: if false;
    }
    match /migracion/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }
    match /cobranza/{clienteId} {
      allow read: if esAdmin();
      allow create: if esAdmin() && nuevo().gestiones is list && nuevo().gestiones.size() <= 5000;
      // la lista de gestiones solo crece (y empieza igual que antes): lo anotado no se borra ni se cambia
      allow update: if esAdmin() && nuevo().gestiones is list && nuevo().gestiones.size() >= antes().gestiones.size()
                    && nuevo().gestiones.size() <= 5000
                    && (antes().gestiones.size() == 0 || nuevo().gestiones[0:antes().gestiones.size()] == antes().gestiones);
      allow delete: if false;
    }
    // v1.8.0: listas de precios (solo administración; logística no las lee)
    match /listas_precios/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && nuevo().cliente is map && nuevo().items is list && nuevo().items.size() <= 120;
      allow delete: if false;
    }
    match /config/{id} {
      // logística lee si la base nueva ya está en uso (config/b2b) y, v1.7.0, la lista del Catálogo (config/catalogoDisponible)
      allow read: if esAdmin() || (esLogistica() && id in ['b2b', 'catalogoDisponible']);
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    // ── Todo lo demás: cerrado ──
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
