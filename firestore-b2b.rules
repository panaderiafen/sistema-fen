rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Fën · B2B (proyecto Firebase fen-b2b) — Reglas de Firestore v1.0.0 (2026-10-06)
//
//  Base nueva de Ventas B2B. Proyecto aparte de la caja (fen-ventas), así
//  cada uno tiene su propia cuota gratis.
//
//  Roles (se administran SOLO desde la consola de Firebase):
//    admins/{uid}      → administración (Sistema Fën): lee y escribe todo
//    logistica/{uid}   → la persona que registra las órdenes (app nueva, v0.12):
//                        por ahora solo puede leer clientes, productos y órdenes
//    cualquier otra cuenta → nada
//
//  Nada se borra: ninguna regla permite delete. Lo que sale de la planilla
//  queda marcado (quitadoEnPlanilla) y lo que se anule quedará anulado.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function esLogistica() {
      return conSesion() && exists(/databases/$(database)/documents/logistica/$(request.auth.uid));
    }
    function nuevo() {
      return request.resource.data;
    }

    // ── Roles: cada cuenta ve solo el suyo; se crean en la consola ──
    match /admins/{uid} {
      allow read: if conSesion() && request.auth.uid == uid;
      allow write: if false;
    }
    match /logistica/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    // ── Catálogo y órdenes: logística lee, administración escribe ──
    match /clientes/{id} {
      allow read: if esAdmin() || esLogistica();
      allow create, update: if esAdmin() && nuevo().nombre is string && nuevo().nombre.size() > 0;
      allow delete: if false;
    }
    match /productos/{id} {
      allow read: if esAdmin() || esLogistica();
      allow create, update: if esAdmin() && nuevo().nombre is string && nuevo().nombre.size() > 0;
      allow delete: if false;
    }
    match /ordenes/{n} {
      allow read: if esAdmin() || esLogistica();
      // El id es el N° de orden y tiene que coincidir con el campo n
      allow create, update: if esAdmin() && nuevo().n is int && string(nuevo().n) == n
                            && nuevo().total is number && nuevo().lineas is list;
      allow delete: if false;
    }

    // ── Solo administración ──
    match /abonos/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && nuevo().monto is number;
      allow delete: if false;
    }
    match /ediciones/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if false;
    }
    match /contadores/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }
    // Registro de las copias desde la planilla (qué se copió y cuándo)
    match /migracion/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }
    match /config/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }

    // ── Todo lo demás: cerrado ──
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
